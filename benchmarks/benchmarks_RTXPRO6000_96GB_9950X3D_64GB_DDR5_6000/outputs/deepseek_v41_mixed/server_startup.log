<script>
(function () {
  const display = document.getElementById('display');

  let displayValue = '0';
  let firstOperand = null;
  let operator = null;
  let waitingForSecondOperand = false;

  // ---------- Display helpers ----------
  function updateDisplay(text) {
    display.textContent = text;
    const len = text.length;
    display.classList.toggle('small', len >= 10);
    display.classList.toggle('tiny', len >= 14);
    display.classList.toggle('error', text === 'Error');
  }

  function formatResult(num) {
    if (!Number.isFinite(num)) return 'Error';
    // Round to 12 significant digits to hide floating point artifacts
    const rounded = parseFloat(num.toPrecision(12));
    return String(rounded);
  }

  function resetCalculator() {
    displayValue = '0';
    firstOperand = null;
    operator = null;
    waitingForSecondOperand = false;
    updateDisplay(displayValue);
  }

  // ---------- Input handling ----------
  function inputDigit(digit) {
    if (displayValue === 'Error') {
      resetCalculator();
    }

    if (waitingForSecondOperand) {
      displayValue = digit;
      waitingForSecondOperand = false;
    } else {
      displayValue = displayValue === '0' ? digit : displayValue + digit;
    }

    updateDisplay(displayValue);
  }

  function inputDecimal() {
    if (displayValue === 'Error') {
      resetCalculator();
    }

    if (waitingForSecondOperand) {
      displayValue = '0.';
      waitingForSecondOperand = false;
    } else if (!displayValue.includes('.')) {
      displayValue += '.';
    }

    updateDisplay(displayValue);
  }

  function handleOperator(nextOperator) {
    if (displayValue === 'Error') {
      resetCalculator();
    }

    // If there is already a pending operation and the second operand is
    // ready, chain-calculate before applying the new operator.
    if (operator && !waitingForSecondOperand) {
      const result = performCalculation();
      if (!Number.isFinite(result)) {
        displayValue = 'Error';
        firstOperand = null;
        operator = null;
        waitingForSecondOperand = false;
        updateDisplay(displayValue);
        return;
      }
      displayValue = formatResult(result);
      firstOperand = Number(displayValue);
      operator = nextOperator;
      waitingForSecondOperand = true;
      updateDisplay(displayValue);
      return;
    }

    if (firstOperand === null) {
      firstOperand = Number(displayValue);
      operator = nextOperator;
      waitingForSecondOperand = true;
      // Keep showing the number currently typed
      updateDisplay(displayValue);
    }
  }

  function performCalculation() {
    const secondOperand = Number(displayValue);
    let result;

    switch (operator) {
      case '+': result = firstOperand + secondOperand; break;
      case '-': result = firstOperand - secondOperand; break;
      case '*': result = firstOperand * secondOperand; break;
      case '/':
        result = secondOperand === 0 ? NaN : firstOperand / secondOperand;
        break;
      default: return NaN;
    }

    return result;
  }

  function calculate() {
    if (operator === null || firstOperand === null) return;

    const result = performCalculation();
    displayValue = formatResult(result);
    updateDisplay(displayValue);

    // After "=", the next input starts a fresh calculation
    firstOperand = null;
    operator = null;
    waitingForSecondOperand = true;
  }

  function backspace() {
    if (displayValue === 'Error') {
      resetCalculator();
      return;
    }
    if (waitingForSecondOperand) return; // nothing meaningful to delete

    displayValue = displayValue.slice(0, -1);
    if (displayValue === '' || displayValue === '-') {
      displayValue = '0';
    }
    updateDisplay(displayValue);
  }

  function percent() {
    const current = Number(displayValue);
    if (!Number.isFinite(current)) {
      resetCalculator();
      return;
    }
    displayValue = formatResult(current / 100);
    updateDisplay(displayValue);

    // Percent effectively replaces the second operand
    if (firstOperand !== null && operator !== null) {
      // If percent pressed before "=", it acts as the second operand
      waitingForSecondOperand = false;
    }
  }

  // ---------- Button clicks ----------
  document.querySelectorAll('button.key').forEach(btn => {
    btn.addEventListener('click', () => {
      const num = btn.dataset.num;
      const opKey = btn.dataset.op;
      const action = btn.dataset.action;

      if (num !== undefined) inputDigit(num);
      else if (opKey !== undefined) handleOperator(opKey);
      else if (action === 'decimal') inputDecimal();
      else if (action === 'equals') calculate();
      else if (action === 'clear') resetCalculator();
      else if (action === 'backspace') backspace();
      else if (action === 'percent') percent();
    });
  });

  // ---------- Keyboard support ----------
  document.addEventListener('keydown', (e) => {
    const key = e.key;
    const lower = key.toLowerCase();

    if (/[0-9]/.test(key)) {
      inputDigit(key);
    } else if (key === '.' || key === ',') {
      inputDecimal();
    } else if (key === '+' || key === '-') {
      handleOperator(key);
    } else if (key === '*' || lower === 'x') {
      handleOperator('*');
    } else if (key === '/') {
      handleOperator('/');
    } else if (key === '=' || key === 'Enter') {
      calculate();
    } else if (key === 'Backspace' || key === 'Delete') {
      backspace();
    } else if (key === 'Escape' || lower === 'c') {
      resetCalculator();
    } else if (key === '%') {
      percent();
    }
  });

  updateDisplay('0');
})();
</script>
</body>
</html>
