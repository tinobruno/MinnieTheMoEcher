<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Calculator</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --bg: #1e1e2e;
      --calc-bg: #181825;
      --display-bg: #11111b;
      --btn: #313244;
      --btn-hover: #45475a;
      --btn-op: #58775e;
      --btn-eq: #89b4fa;
      --text: #cdd6f4;
      --text-dim: #7f849c;
      --radius: 16px;
    }

    body {
      font-family: "Segoe UI", system-ui, -apple-system, sans-serif;
      background: var(--bg);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 16px;
    }

    .calculator {
      width: 100%;
      max-width: 340px;
      background: var(--calc-bg);
      border-radius: 24px;
      padding: 20px;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
    }

    /* ---------- Display ---------- */
    .display {
      background: var(--display-bg);
      border-radius: var(--radius);
      padding: 16px 18px;
      margin-bottom: 18px;
      text-align: right;
      overflow: hidden;
    }

    .display .expression {
      font-size: 1rem;
      color: var(--text-dim);
      min-height: 1.2em;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .display .result {
      font-size: 2.2rem;
      font-weight: 600;
      color: var(--text);
      margin-top: 4px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      transition: font-size 0.15s ease;
    }

    .display .result.shrink {
      font-size: 1.4rem;
    }

    /* ---------- Buttons ---------- */
    .buttons {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
    }

    button {
      border: none;
      border-radius: var(--radius);
      padding: 18px 0;
      font-size: 1.15rem;
      font-weight: 600;
      color: var(--text);
      background: var(--btn);
      cursor: pointer;
      transition: transform 0.1s ease, background 0.15s ease;
      -webkit-tap-highlight-color: transparent;
    }

    button:hover {
      background: var(--btn-hover);
    }

    button:active {
      transform: scale(0.94);
    }

    button.op {
      background: var(--btn-op);
      color: #fff;
    }

    button.eq {
      background: var(--btn-eq);
      color: #11111b;
    }

    button.fn {
      background: #45475a;
      color: var(--text-dim);
    }

    /* ---------- Responsive tweaks ---------- */
    @media (max-width: 380px) {
      .calculator {
        padding: 14px;
        border-radius: 18px;
      }
      .buttons {
        gap: 8px;
      }
      button {
        padding: 14px 0;
        font-size: 1rem;
      }
      .display .result {
        font-size: 1.8rem;
      }
    }
  </style>
</head>
