def fibonacci(n: int) -> int:
    """
    Calculate the nth Fibonacci number[2026-11-01 17:02:48] [INFO] VERIFY TIMING: cycle=4 M=4 took 18.69ms (graph=1)
 iteratively.

    The Fibonacci sequence is defined by the recurrence relation:
    F(n) = F(n-1) + F(n-2), with seed values F(0) = 0 and F(1) = 1.

    Args:
        n (int): The position in the Fibonacci sequence (must be non-negative).

    Returns:
        int: The nth Fibonacci number.

    Raises:
        ValueError: If n is negative.
    """
    if n < 0:
        raise ValueError("Input must be a non-negative integer.")

    # Base cases
    if n == 0:
        return 0
    if n == 1:
        return 1

    # Iterative calculation
    prev, curr = 0, 1
    for _ in range(2, n + 1):
        prev, curr = curr, prev + curr

    return curr
```

